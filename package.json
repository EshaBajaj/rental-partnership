{
  "name": "shop-lead-screener",
  "private": true,
  "workspaces": ["apps/web"],
  "scripts": {
    "dev": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/web run build",
    "typecheck": "npm --workspace apps/web run typecheck",
    "test": "npm --workspace apps/web run test",
    "test:db": "bash scripts/test-db.sh",
    "test:functions": "bash scripts/test-functions.sh",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check": "npm run typecheck && npm test && npm run test:functions && npm run test:db && npm run build && npm run check:bundle"
  },
  "engines": { "node": ">=20" }
}
