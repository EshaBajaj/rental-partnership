VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key — safe to ship in the browser.
# NEVER put the secret / service_role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# optional: defaults to $VITE_SUPABASE_URL/functions/v1
VITE_FUNCTIONS_URL=
# the property slug that "/" redirects to
VITE_DEFAULT_SLUG=main-road-shop
